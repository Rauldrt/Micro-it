rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Lectura pública de videos e imágenes de las soluciones
    match /solutions/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
